# US official OpenAPI. Startup profile; switching in the dashboard is session-only.
WEBULL_ENV=sandbox
# Legacy sandbox fields remain supported when the new SANDBOX fields are empty.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
# Run the accounts command, then enter a sandbox account_id here.
WEBULL_ACCOUNT_ID=
# Live opt-in: keep false until production validation and risk review are complete.
# Even true requires a time-limited live arm and a per-order confirmation.
WEBULL_ENABLE_LIVE_TRADING=false

# Optional explicit sandbox profile (fill all three, or keep using legacy fields).
WEBULL_SANDBOX_APP_KEY=
WEBULL_SANDBOX_APP_SECRET=
WEBULL_SANDBOX_ACCOUNT_ID=
# Production credentials/account MUST be separate from sandbox.
WEBULL_LIVE_APP_KEY=
WEBULL_LIVE_APP_SECRET=
WEBULL_LIVE_ACCOUNT_ID=

# Run: python manage.py init (generates this backend key locally).
TRADING_API_KEY=
TRADING_MAX_ORDER_QUANTITY=100
TRADING_MAX_ORDER_NOTIONAL=10000
TRADING_MAX_SYMBOL_EXPOSURE=20000
TRADING_MAX_PORTFOLIO_EXPOSURE=100000
TRADING_MAX_OPEN_ORDERS=20
TRADING_MAX_DAILY_ORDERS=50
TRADING_MAX_DAILY_LOSS=1000
TRADING_MAX_PRICE_DEVIATION=0.10
TRADING_MAX_QUOTE_AGE_SECONDS=120
TRADING_RECONCILE_INTERVAL=15

# Conservative live pilot defaults; independent of sandbox settings.
TRADING_LIVE_ARM_SECONDS=600
TRADING_LIVE_MAX_ORDER_QUANTITY=5
TRADING_LIVE_MAX_ORDER_NOTIONAL=500
TRADING_LIVE_MAX_SYMBOL_EXPOSURE=1000
TRADING_LIVE_MAX_PORTFOLIO_EXPOSURE=5000
TRADING_LIVE_MAX_OPEN_ORDERS=3
TRADING_LIVE_MAX_DAILY_ORDERS=5
TRADING_LIVE_MAX_DAILY_LOSS=50
TRADING_LIVE_MAX_PRICE_DEVIATION=0.02
TRADING_LIVE_MAX_QUOTE_AGE_SECONDS=30
TRADING_LIVE_FEE_BUFFER=0.01
